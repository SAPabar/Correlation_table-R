# 3. Fájl kiválasztása
df <- read_excel("FACE 2019.xlsx")

# 4. Adat szűkítés, ha csak bizonyos sorok kellenek.
df <- df[c(3:26),]
# 5. ADATTÍPUSOK optimalizálása (faktorok, numerikusok) # Ezzel van amelyik kódot átnvezzük: N ->Nemere
df <- df %>%
  mutate(
    # Kategória változók faktorrá alakítása (ANOVA-hoz)
    co2_level = factor(co2_level, levels = c("FACE", "Kontrol")),
    n_level = factor(n_level, levels = c("High", "Low")),
    cultivar = factor(cultivar, levels = c("Nemere", "Dandár")), 
    
    # Minden többi numerikusra (hullámhosszak, kémiai paraméterek)
    across(c("Gyökér biomassza":"Hossz/Tömeg"), as.numeric),
    
    # sample_i megtartása karakterként (mintaazonosító)
    sample_i = as.character("2019")
  )
# ellenőrzés
str(df)


# 6. Oszlopok kiválasztása amikkel dolgozunk és átnevezés -------------------------
# Kívánt oszlopok nevei
desired_columns <- c("Gyökér biomassza", "WR teljes gyökérhossz", "WR gyökér felszín", "WR átl gyökér átmérő", "Hajtás biomassza", "CCI", "FvFm", "Levélfelület", "Termésadatok", "CR", "Gyökér/Hajtás", "Hossz/Tömeg") #Első és utolsó oszlopod nevének a megadása. Ugyanaz mint a numerikus adatok megadásánál.

# Új nevek megadása az oszlopoknak
new_column_names <- c("Gyökér biomassza", "WR hossz", "WR  felszín", "WR átmérő", "Hajtás tömeg", "CCI", "Fv/Fm", "Levélfelület", "Termés", "CR", "Gyökér/Hajtás", "Hossz/tömeg")

# Ellenőrizzük, hogy a hosszúságuk megegyezik-e
if (length(desired_columns) == length(new_column_names)) {
  # Csak a ténylegesen létező oszlopokat nevezzük át
  existing_columns <- colnames(df)[colnames(df) %in% desired_columns]
  existing_new_names <- new_column_names[desired_columns %in% colnames(df)]
  
  # Az oszlopok átnevezése
  colnames(df)[colnames(df) %in% existing_columns] <- existing_new_names
  
  # Ellenőrzés céljából kiírhatod az új oszlopneveket
  print(colnames(df))
  
} else {
  warning("A jelenlegi és az új változónevek száma nem egyezik meg.")
}

